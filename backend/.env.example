# Local defaults. The API also runs without this file using backend/lifestrategy.db.
APP_ENV=development
DATABASE_URL=sqlite:///./lifestrategy.db
# The Vite dev server origin permitted by CORS. Multiple origins can use commas.
FRONTEND_URL=http://127.0.0.1:5173

# Railway production example (set these in Railway Variables, not in this file):
# APP_ENV=production
# DATABASE_URL=sqlite:////app/data/lifestrategy.db
# FRONTEND_URL=https://your-vercel-project.vercel.app
